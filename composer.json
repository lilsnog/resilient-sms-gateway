{
    "name": "godswill/resilient-sms-gateway",
    "description": "Multi-provider SMS gateway for PHP and Laravel with routing, automatic failover and per-provider circuit breakers.",
    "type": "library",
    "license": "MIT",
    "keywords": ["sms", "laravel", "failover", "circuit-breaker", "notifications"],
    "authors": [
        {
            "name": "Godswill Sam-Nwafor",
            "email": "chisomsamuel1@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "suggest": {
        "illuminate/support": "Required for the Laravel service provider and queued SendSms job (^10.0 || ^11.0)",
        "ext-curl": "Required by HttpJsonProvider's default transport"
    },
    "autoload": {
        "psr-4": {
            "SmsGateway\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SmsGateway\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SmsGateway\\Laravel\\SmsGatewayServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable"
}
